{
    "$schema": "./tools/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php:\/\/stderr",
        "stryker": {
            "report": "/^\\d\\.\\d\\.x$/"
        }
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 98,
    "minCoveredMsi": 98,
    "staticAnalysisTool": "phpstan",
    "phpStan": {
        "customPath": "tools/vendor/bin/phpstan"
    }
}
